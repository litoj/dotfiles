<UE023> <UE027> <UE01C> : "ピョ"

# h = U+E024
<UE024> <UE018> : "ハ"
<UE024> <UE019> : "ヒ"
<UE024> <UE01A> : "フ"
<UE024> <UE01B> : "ヘ"
