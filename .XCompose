# Romaji sequences for the jprom(romaji) NumLock-gated layout.
# Markers: one hole-free block in this letter order from U+E001
# (hiragana) and again from U+E018 (katakana, marker + 0x17):
#   a i u e o  k s z t d n p h g m y r w b  c f j  x
# Spelling model - one letter, one kana part:
# - consonant + vowel = the row kana; the y key makes small
#   ゃゅょ, so Hepburn contractions (ja, sha, cha, ...) do not
#   exist, only the letter-by-letter forms shi chi tsu fu ji
#   shya chya jya
# - fa fi fe fo and wi we are foreign sounds; x prefixes small
#   kana; nn (or n') gives ん; a doubled consonant gives っ
include "%L"

# vowels a i u e o = U+E001..U+E005
<UE001> : "あ"
<UE002> : "い"
<UE003> : "う"
<UE004> : "え"
<UE005> : "お"

# k = U+E006
<UE006> <UE001> : "か"
<UE006> <UE002> : "き"
<UE006> <UE003> : "く"
<UE006> <UE004> : "け"
<UE006> <UE005> : "こ"
<UE006> <UE010> <UE001> : "きゃ"
<UE006> <UE010> <UE003> : "きゅ"
<UE006> <UE010> <UE005> : "きょ"

# s = U+E007
<UE007> <UE001> : "さ"
<UE007> <UE002> : "し"
<UE007> <UE003> : "す"
<UE007> <UE004> : "せ"
<UE007> <UE005> : "そ"
<UE007> <UE010> <UE001> : "しゃ"
<UE007> <UE010> <UE003> : "しゅ"
<UE007> <UE010> <UE005> : "しょ"
# Hepburn alias: s + h spells the し sound
<UE007> <UE00D> <UE002> : "し"
<UE007> <UE00D> <UE010> <UE001> : "しゃ"
<UE007> <UE00D> <UE010> <UE003> : "しゅ"
<UE007> <UE00D> <UE010> <UE005> : "しょ"

# z = U+E008
<UE008> <UE001> : "ざ"
<UE008> <UE002> : "じ"
<UE008> <UE003> : "ず"
<UE008> <UE004> : "ぜ"
<UE008> <UE005> : "ぞ"
<UE008> <UE010> <UE001> : "じゃ"
<UE008> <UE010> <UE003> : "じゅ"
<UE008> <UE010> <UE005> : "じょ"

# t = U+E009
<UE009> <UE001> : "た"
<UE009> <UE002> : "ち"
<UE009> <UE003> : "つ"
<UE009> <UE004> : "て"
<UE009> <UE005> : "と"
<UE009> <UE010> <UE001> : "ちゃ"
<UE009> <UE010> <UE003> : "ちゅ"
<UE009> <UE010> <UE005> : "ちょ"
# Hepburn alias: t + s spells the つ sound
<UE009> <UE007> <UE003> : "つ"

# d = U+E00A
<UE00A> <UE001> : "だ"
<UE00A> <UE002> : "ぢ"
<UE00A> <UE003> : "づ"
<UE00A> <UE004> : "で"
<UE00A> <UE005> : "ど"
<UE00A> <UE010> <UE001> : "ぢゃ"
<UE00A> <UE010> <UE003> : "ぢゅ"
<UE00A> <UE010> <UE005> : "ぢょ"

# n = U+E00B; ん is typed as nn or n'
<UE00B> <UE001> : "な"
<UE00B> <UE002> : "に"
<UE00B> <UE003> : "ぬ"
<UE00B> <UE004> : "ね"
<UE00B> <UE005> : "の"
<UE00B> <UE010> <UE001> : "にゃ"
<UE00B> <UE010> <UE003> : "にゅ"
<UE00B> <UE010> <UE005> : "にょ"
<UE00B> <UE00B> : "ん"
<UE00B> <apostrophe> : "ん"
# nn before a vowel: ん plus the な-row kana
<UE00B> <UE00B> <UE001> : "んな"
<UE00B> <UE00B> <UE002> : "んに"
<UE00B> <UE00B> <UE003> : "んぬ"
<UE00B> <UE00B> <UE004> : "んね"
<UE00B> <UE00B> <UE005> : "んの"

# p = U+E00C
<UE00C> <UE001> : "ぱ"
<UE00C> <UE002> : "ぴ"
<UE00C> <UE003> : "ぷ"
<UE00C> <UE004> : "ぺ"
<UE00C> <UE005> : "ぽ"
<UE00C> <UE010> <UE001> : "ぴゃ"
<UE00C> <UE010> <UE003> : "ぴゅ"
<UE00C> <UE010> <UE005> : "ぴょ"

# h = U+E00D
<UE00D> <UE001> : "は"
<UE00D> <UE002> : "ひ"
<UE00D> <UE003> : "ふ"
<UE00D> <UE004> : "へ"
<UE00D> <UE005> : "ほ"
<UE00D> <UE010> <UE001> : "ひゃ"
<UE00D> <UE010> <UE003> : "ひゅ"
<UE00D> <UE010> <UE005> : "ひょ"

# g = U+E00E
<UE00E> <UE001> : "が"
<UE00E> <UE002> : "ぎ"
<UE00E> <UE003> : "ぐ"
<UE00E> <UE004> : "げ"
<UE00E> <UE005> : "ご"
<UE00E> <UE010> <UE001> : "ぎゃ"
<UE00E> <UE010> <UE003> : "ぎゅ"
<UE00E> <UE010> <UE005> : "ぎょ"

# m = U+E00F
<UE00F> <UE001> : "ま"
<UE00F> <UE002> : "み"
<UE00F> <UE003> : "む"
<UE00F> <UE004> : "め"
<UE00F> <UE005> : "も"
<UE00F> <UE010> <UE001> : "みゃ"
<UE00F> <UE010> <UE003> : "みゅ"
<UE00F> <UE010> <UE005> : "みょ"

# y = U+E010; alone it is the や row, after a consonant it
# shrinks the next vowel kana to small ゃゅょ
<UE010> <UE001> : "や"
<UE010> <UE003> : "ゆ"
<UE010> <UE005> : "よ"

# r = U+E011
<UE011> <UE001> : "ら"
<UE011> <UE002> : "り"
<UE011> <UE003> : "る"
<UE011> <UE004> : "れ"
<UE011> <UE005> : "ろ"
<UE011> <UE010> <UE001> : "りゃ"
<UE011> <UE010> <UE003> : "りゅ"
<UE011> <UE010> <UE005> : "りょ"

# w = U+E012; wa and wo are kana, wi and we are the foreign
# sounds うぃ うぇ
<UE012> <UE001> : "わ"
<UE012> <UE005> : "を"
<UE012> <UE002> : "うぃ"
<UE012> <UE004> : "うぇ"

# b = U+E013
<UE013> <UE001> : "ば"
<UE013> <UE002> : "び"
<UE013> <UE003> : "ぶ"
<UE013> <UE004> : "べ"
<UE013> <UE005> : "ぼ"
<UE013> <UE010> <UE001> : "びゃ"
<UE013> <UE010> <UE003> : "びゅ"
<UE013> <UE010> <UE005> : "びょ"

# c = U+E014, Hepburn only: c + h spells the ち sound
<UE014> <UE00D> <UE002> : "ち"
<UE014> <UE00D> <UE010> <UE001> : "ちゃ"
<UE014> <UE00D> <UE010> <UE003> : "ちゅ"
<UE014> <UE00D> <UE010> <UE005> : "ちょ"

# f = U+E015, Hepburn: fu = ふ; fa fi fe fo are the foreign
# sounds ふぁ ふぃ ふぇ ふぉ
<UE015> <UE003> : "ふ"
<UE015> <UE001> : "ふぁ"
<UE015> <UE002> : "ふぃ"
<UE015> <UE004> : "ふぇ"
<UE015> <UE005> : "ふぉ"

# j = U+E016, Hepburn: ji = じ; the small ゃ always needs the
# y key, so じゃ is jya or zya, never ja
<UE016> <UE002> : "じ"
<UE016> <UE010> <UE001> : "じゃ"
<UE016> <UE010> <UE003> : "じゅ"
<UE016> <UE010> <UE005> : "じょ"

# x = U+E017, small-kana prefix
<UE017> <UE001> : "ぁ"
<UE017> <UE002> : "ぃ"
<UE017> <UE003> : "ぅ"
<UE017> <UE004> : "ぇ"
<UE017> <UE005> : "ぉ"
<UE017> <UE010> <UE001> : "ゃ"
<UE017> <UE010> <UE003> : "ゅ"
<UE017> <UE010> <UE005> : "ょ"
<UE017> <UE009> <UE003> : "っ"
<UE017> <UE009> <UE007> <UE003> : "っ"

# a doubled consonant gives っ, joined with the kana after it
<UE006> <UE006> : "っ"
<UE006> <UE006> <UE001> : "っか"
<UE006> <UE006> <UE002> : "っき"
<UE006> <UE006> <UE003> : "っく"
<UE006> <UE006> <UE004> : "っけ"
<UE006> <UE006> <UE005> : "っこ"
<UE006> <UE006> <UE010> <UE001> : "っきゃ"
<UE006> <UE006> <UE010> <UE003> : "っきゅ"
<UE006> <UE006> <UE010> <UE005> : "っきょ"
<UE007> <UE007> : "っ"
<UE007> <UE007> <UE001> : "っさ"
<UE007> <UE007> <UE002> : "っし"
<UE007> <UE007> <UE003> : "っす"
<UE007> <UE007> <UE004> : "っせ"
<UE007> <UE007> <UE005> : "っそ"
<UE007> <UE007> <UE010> <UE001> : "っしゃ"
<UE007> <UE007> <UE010> <UE003> : "っしゅ"
<UE007> <UE007> <UE010> <UE005> : "っしょ"
<UE008> <UE008> : "っ"
<UE008> <UE008> <UE001> : "っざ"
<UE008> <UE008> <UE002> : "っじ"
