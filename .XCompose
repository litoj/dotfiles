# katakana = NumLock+Shift: markers U+E018..U+E02E, same letter
# order as the hiragana block (marker + 0x17), rules mirrored
# one to one (kana code point + 0x60)

# vowels a i u e o = U+E018..U+E01C
<UE018> : "ア"
<UE019> : "イ"
<UE01A> : "ウ"
<UE01B> : "エ"
<UE01C> : "オ"

# k = U+E01D
<UE01D> <UE018> : "カ"
<UE01D> <UE019> : "キ"
<UE01D> <UE01A> : "ク"
<UE01D> <UE01B> : "ケ"
<UE01D> <UE01C> : "コ"
<UE01D> <UE027> <UE018> : "キャ"
<UE01D> <UE027> <UE01A> : "キュ"
<UE01D> <UE027> <UE01C> : "キョ"

# s = U+E01E
<UE01E> <UE018> : "サ"
<UE01E> <UE019> : "シ"
<UE01E> <UE01A> : "ス"
<UE01E> <UE01B> : "セ"
<UE01E> <UE01C> : "ソ"
<UE01E> <UE027> <UE018> : "シャ"
<UE01E> <UE027> <UE01A> : "シュ"
<UE01E> <UE027> <UE01C> : "ショ"
# Hepburn alias: s + h spells the シ sound
<UE01E> <UE024> <UE019> : "シ"
<UE01E> <UE024> <UE027> <UE018> : "シャ"
<UE01E> <UE024> <UE027> <UE01A> : "シュ"
<UE01E> <UE024> <UE027> <UE01C> : "ショ"

# z = U+E01F
<UE01F> <UE018> : "ザ"
<UE01F> <UE019> : "ジ"
<UE01F> <UE01A> : "ズ"
<UE01F> <UE01B> : "ゼ"
<UE01F> <UE01C> : "ゾ"
<UE01F> <UE027> <UE018> : "ジャ"
<UE01F> <UE027> <UE01A> : "ジュ"
<UE01F> <UE027> <UE01C> : "ジョ"

# t = U+E020
<UE020> <UE018> : "タ"
<UE020> <UE019> : "チ"
<UE020> <UE01A> : "ツ"
<UE020> <UE01B> : "テ"
<UE020> <UE01C> : "ト"
<UE020> <UE027> <UE018> : "チャ"
<UE020> <UE027> <UE01A> : "チュ"
<UE020> <UE027> <UE01C> : "チョ"
# Hepburn alias: t + s spells the ツ sound
<UE020> <UE01E> <UE01A> : "ツ"

# d = U+E021
<UE021> <UE018> : "ダ"
<UE021> <UE019> : "ヂ"
<UE021> <UE01A> : "ヅ"
<UE021> <UE01B> : "デ"
<UE021> <UE01C> : "ド"
<UE021> <UE027> <UE018> : "ヂャ"
<UE021> <UE027> <UE01A> : "ヂュ"
<UE021> <UE027> <UE01C> : "ヂョ"

# n = U+E022; ン is typed as nn or n'
<UE022> <UE018> : "ナ"
<UE022> <UE019> : "ニ"
<UE022> <UE01A> : "ヌ"
<UE022> <UE01B> : "ネ"
<UE022> <UE01C> : "ノ"
<UE022> <UE027> <UE018> : "ニャ"
<UE022> <UE027> <UE01A> : "ニュ"
<UE022> <UE027> <UE01C> : "ニョ"
<UE022> <UE022> : "ン"
<UE022> <apostrophe> : "ン"
# nn before a vowel: ン plus the ナ-row kana
<UE022> <UE022> <UE018> : "ンナ"
<UE022> <UE022> <UE019> : "ンニ"
<UE022> <UE022> <UE01A> : "ンヌ"
<UE022> <UE022> <UE01B> : "ンネ"
<UE022> <UE022> <UE01C> : "ンノ"

