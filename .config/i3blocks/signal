#!/usr/bin/bash
#Signal-managing script for statusbar

setTheme() {
	gsettings set org.gnome.desktop.interface color-scheme prefer-${1,,}
	gsettings set org.gnome.desktop.interface gtk-theme ${1^}
	sed "s/Dark/${1^}/" ~/.config/gtk-3.0/theme.ini >/tmp/my/gtk3rc
	sed '1d;s/=\([a-z].*\|[A-Z][^A-Z].*\)/="\1"/' /tmp/my/gtk3rc >/tmp/my/gtk2rc
	ln -sf ~/.config/qt6ct/colors/$1.conf /tmp/my/qt
	ln -sf ~/.config/rofi/$1.rasi /tmp/my/rofi
	ln -sf ~/.config/foot/$1.ini /tmp/my/foot

	# toggle theme for foot terminal linked to /bin/xterm
	local signal
	[[ $1 == dark ]] && signal=SIGUSR1 || signal=SIGUSR2
	pkill --signal $signal xterm

	local msg="\x94\x0\x1\xafnvim_set_option\x92\xaabackground\xa${#1}$1"

	for f in /run/user/$(id -u)/nvim.*.0; do
		local pid=${f#*.}
		ps -p ${pid%.*} >/dev/null && printf "$msg" | ncat -U "$f"
	done
}

theme() {
	if [[ ! $DAYTIME ]]; then
		local DAYTIME=(0 1)
		[[ $1 == light || ($1 == toggle && ! -e /tmp/my/day) ]] && x=0 || x=1
	fi

	if ((DAYTIME[0] <= x && x < DAYTIME[1])); then
		[[ ! -e /tmp/my/day ]] && touch /tmp/my/day && setTheme light
		swaymsg -q 'set $bg #ffffff; set $fg #000000'
		next=${DAYTIME[1]}
	else
		rm /tmp/my/day &>/dev/null || [[ -z $next ]] && setTheme dark
		swaymsg -q 'set $bg #101010; set $fg #ffffff'
		next=${DAYTIME[0]}
	fi
	swaymsg -q "$(grep 'colors {' -A 10 ~/.config/sway/20_layout.swayconf |
		grep '\$' -B 10 | sed '1d;/^\s*#/d;s/^/bar bar-0 colors/')"
}

clock() {
	local DAYTIME=($(sunwait list 50N 14.5E | sed 's/:/ /g;s/,//' | awk '{print($1*3600+$2*60,$3*3600+$4*60)}'))

	while ((! $?)); do
		x=($(date +'%-H %-M %-S'))
		((x = x * 3600 + x[1] * 60 + x[2]))
		theme
		if ((x > next)); then
			sleep $((3600 * 24 - x)) || exit # wait till midnight
			pkill -RTMIN+20 i3blocks         # update the date
			sleep $next                      # wait till sunrise to switch back to lightmode
		else
			sleep $((next - x))
		fi
	done &

	# update the clock status from here so that it can also process mouse clicks
	while sleep $((60 - $(date +%-S))); do
		pkill -RTMIN+21 i3blocks
	done
}

wp() {
	local arg=$1
	declare -A nodes def
	while ((! $?)); do
		{
			while read -r line; do
				[[ $line == '├─ Sinks:' ]] && break
			done
			category=sink
			while read -r line; do
				if [[ ${line:3} =~ ^(\*)?\ +([0-9]+)\.\ ([^ ]+(\ [^ ]+)*) ]]; then
					if [[ $category == filter ]]; then
						type=${BASH_REMATCH[3]##*-}
						BASH_REMATCH[3]="Echo ${type^}"
					else
						type=$category
					fi
					nodes["${BASH_REMATCH[3]}"]="${BASH_REMATCH[2]};$type"
					if [[ ${BASH_REMATCH[1]} == \* ]]; then
						def["$type"]=${BASH_REMATCH[3]}
					fi
				elif [[ ${line:3} =~ ^([A-Z][a-z]+)s ]]; then
					[[ $BASH_REMATCH == Streams ]] && break
					category=${BASH_REMATCH[1],}
				fi
			done
		} < <(wpctl status)
		[[ ${def[@]} ]] || ((++tries > 5)) && break || sleep 1
	done
	unset nodes['Echo Capture'] nodes['Echo Playback']

	if [[ $arg != detect ]]; then
		if [[ $arg ]]; then
			glob=$arg
		else
			glob=${def['sink']:-${def['source']}}
			glob=$(printf '%s\n' "${!nodes[@]}" | rofi -dmenu -i -p "Audio (${glob%% *})")
		fi
		if [[ $glob ]]; then
			[[ $glob == *\* ]] || glob="${glob%% *}*"

			for k in "${!nodes[@]}"; do
				[[ $k == $glob ]] && def[${nodes["$k"]#*;}]=$k
			done
		fi
	fi
	msg="Sink: ${def['sink']:=Echo Sink}\nSource: ${def['source']:=Echo Source}"

	if ! [[ ${nodes["${def['sink']}"]} && ${nodes["${def['source']}"]} ]]; then
		notify-send -u critical -t 2000 'Audio Err' "$msg"
		exit 1
	fi

	notify-send -t 1500 "Audio ${glob:-Default}" "$msg"
	wpctl set-default ${nodes["${def['sink']}"]%;*}
	wpctl set-default ${nodes["${def['source']}"]%;*}
	[[ ${def['sink']} == Echo* ]] && def['sink']='Builtin Sink'
	[[ ${def['source']} == Echo* ]] && def['source']='Builtin Source'
	echo "${nodes["${def['sink']}"]%;*} ${nodes["${def['source']}"]%;*}" >/tmp/my/wp
	pkill -RTMIN+10 i3blocks && pkill -RTMIN+11 i3blocks
}

checkPower() {
	local profile
	if ((! $#)); then
		read profile </sys/class/power_supply/BAT0/status
	else
		(($1)) && profile=Charging || profile=Discharging
	fi

	if [[ $profile != D* ]]; then
		profile=Auto
		pkill -f 'bash hibernateDelayed.sh'
	else
		profile=Powersave
	fi
	"${0%/*}/cpu" "$profile"

	{
		sleep 1 && pkill -RTMIN+14 i3blocks # update battery status
	} &
}

load() {
	killall acpi_listen sleep
	clock &
	checkPower
	wp detect

	while read -r line; do
		case "$line" in
			jack/head*) pkill -RTMIN+10 i3blocks ;;
			jack/micro*) pkill -RTMIN+11 i3blocks ;;
			# plugging in emmits the *1 event twice
			ac_adapter*) [[ ${line:0-1} == 0 ]] || read -r line && checkPower ${line:0-1} ;;
			button/lid*open) sleep 1 && checkPower ;;
		esac
	done < <(acpi_listen)
}

case "$1" in
	vol | mic)
		[[ $1 == vol ]] && i=0 || i=1

		read -ra WP </tmp/my/wp
		if [[ $2 == toggle ]]; then
			wpctl set-mute ${WP[i]} "$2"
		else
			wpctl set-volume ${WP[i]} "$2"
		fi
		pkill -RTMIN+$((10 + i)) i3blocks
		;;
	*) "$@" ;;
esac
