{
	"$schema": "https://opencode.ai/config.json",
	// "lsp": true,
	"references": {
		"central-ai-notes": {
			"path": "./central-ai-notes",
			"description": "Shared working memory for all projects; follow its AGENTS.md entrypoint"
		}
	},
	"compaction": {
		"auto": true,
		"keep": {"tokens": 15000},
		"reserved": 10000,
		"buffer": 10000
	},
	// The notes sit outside every project Location; allow that boundary
	// instead of relying on the built-in global-config exemption.
	"permissions": [
		{
			"action": "external_directory",
			"resource": "~/.config/opencode/central-ai-notes/*",
			"effect": "allow"
		}
	],
	"provider": {
		"e-infra": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "E-Infra",
			"options": {
				"apiKey": "{env:E_INFRA_KEY}",
				"baseURL": "https://llm.ai.e-infra.cz/v1"
			},
			"models": {
				"mini": {
					"limit": {"input": 200000, "context": 200000, "output": 100000}
				},
				"thinker": {
					"limit": {"input": 1000000, "context": 1000000, "output": 128000}
				},
				"glm-5.3": {
					"limit": {"input": 1000000, "context": 1000000, "output": 128000}
				},
				"deepseek-v4.1-flash-thinking": {
					"limit": {"input": 1000000, "context": 400000, "output": 100000}
				}
			}
		}
	}
}
