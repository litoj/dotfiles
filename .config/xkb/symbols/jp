// Keyboard layouts for Japan.

// All kana variants share one design: hiragana in the base level,
// katakana on Shift, the small form of the same kana on AltGr and
// AltGr+Shift where a small form exists, and the sound marks on
// <AE11> and <AE12>. The whole alphanumeric block and F1-F10 hold
// kana, so this group has no digits and no function keys; switch
// groups for those. The empty gojuon slots (yi, ye, wi, we) keep
// their Latin keys.

// The gojuon table rotated to the left: each keyboard column holds
// one kana row (a, ka, sa, ta, na, ha, ma, ya, ra, wa from left to
// right) and reads o, e, u, i, a top to bottom.
//
//      F  お こ そ と の ほ も よ ろ を
//      1  え け せ て ね へ め     れ
//      q  う く す つ ぬ ふ む ゆ る ん
//      a  い き し ち に ひ み     り
//      z  あ か さ た な は ま や ら わ
default partial alphanumeric_keys function_keys
xkb_symbols "rotated" {

    name[Group1]= "Japanese (Kana, rotated)";

    key <HKTG>	{[ Hiragana_Katakana, Romaji ], type[group1]="PC_ALT_LEVEL2" };
    key <AE11>	{[ voicedsound, semivoicedsound ]};
