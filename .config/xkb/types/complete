// Shadow of the system types/complete that adds the gate file
// with the NL_GATE type (libxkbcommon searches ~/.config/xkb
// first). Keep in sync with the system file on xkeyboard-config
// updates.
default xkb_types "complete" {
    include "basic"
    include "pc"
    include "iso9995"
    include "extra"
    include "level5"
    include "numpad"
    include "mousekeys"
    include "gate"
};
